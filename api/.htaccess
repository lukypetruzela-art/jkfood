# Z celé složky api/ jsou zvenku dostupné jen skripty poptavka.php a kariera.php.
# Konfigurace s heslem, knihovny a log jsou pro prohlížeč zakázané.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <FilesMatch "^(poptavka|kariera)\.php$">
        Require all granted
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <FilesMatch "^(poptavka|kariera)\.php$">
        Allow from all
    </FilesMatch>
</IfModule>
