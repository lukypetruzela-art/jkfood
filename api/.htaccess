# Z celé složky api/ je zvenku dostupný jen skript poptavka.php.
# Konfigurace s heslem, knihovny a log jsou pro prohlížeč zakázané.
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    <Files "poptavka.php">
        Require all granted
    </Files>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "poptavka.php">
        Allow from all
    </Files>
</IfModule>
